# Copy to .env (next to the scripts) or ~/.config/stock-research-bot.env,
# then chmod 600. Both files are read; values already in the environment win.

# From @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# The broadcast channel the reports and alerts post to. The bot must be an
# administrator there. A public channel can use @yourchannel; a private one
# needs the numeric ID, which starts with -100.
TELEGRAM_CHAT_ID=@yourchannel

# The channel's linked discussion group, where people type /pillars, /price...
# The bot answers commands only here (and in TELEGRAM_OWNER_ID's DMs).
TELEGRAM_GROUP_ID=-1001234567890

# Optional: your own Telegram user ID, to use the bot in a direct message.
# TELEGRAM_OWNER_ID=123456789

# Required for SEC EDGAR (pillars, valuation, dilution, filings). SEC asks for
# a name and a contact email: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name you@example.com"

# Optional.
# SRB_OUTPUT_DIR=/path/to/reports          # default: data/reports
# SRB_THEME_DB=/path/to/themes.sqlite      # premarket Theme Watch archive
# CLAUDE_BIN=/usr/local/bin/claude         # default: claude on PATH
# YT_TRANSCRIPT_BIN=/usr/local/bin/yt-transcript
