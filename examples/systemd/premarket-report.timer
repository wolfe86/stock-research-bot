# Weekdays at 05:45 LOCAL time (the machine's time zone). The report covers
# premarket from 04:00 ET, so pick a time after that in your zone.
# Change the time BEFORE the first enable. Editing OnCalendar later on a
# Persistent=true timer can fire a "missed" run as soon as you daemon-reload.
[Unit]
Description=Run the premarket report on weekday mornings

[Timer]
OnCalendar=Mon-Fri *-*-* 05:45:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
